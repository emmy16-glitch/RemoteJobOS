# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may still use an anon key; publishable key is preferred.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional enrichment only. Core discovery, matching and application logic must work with "none".
ENRICHMENT_PROVIDER=none

# Optional Groq adapter. Not required by RemoteJobOS.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Agent
REMOTEJOBOS_DRY_RUN=true
