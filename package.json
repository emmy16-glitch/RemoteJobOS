{
  "name": "remotejobos",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @remotejobos/web",
    "build": "npm run build --workspace @remotejobos/core && npm run build --workspace @remotejobos/worker && npm run build --workspace @remotejobos/web",
    "typecheck": "npm run build --workspace @remotejobos/core && npm run typecheck --workspace @remotejobos/worker && npm run typecheck --workspace @remotejobos/web",
    "worker:discover": "npm run discover --workspace @remotejobos/worker",
    "worker:health": "npm run health --workspace @remotejobos/worker",
    "worker:match": "npm run match --workspace @remotejobos/worker",
    "test": "npm run test --workspace @remotejobos/core",
    "worker:prepare-cvs": "npm run prepare-cvs --workspace @remotejobos/worker",
    "worker:sync-applications": "npm run sync-applications --workspace @remotejobos/worker",
    "worker:process-application-tasks": "npm run process-application-tasks --workspace @remotejobos/worker",
    "worker:decide-approval": "npm run decide-approval --workspace @remotejobos/worker",
    "worker:process-approved-submission": "npm run process-approved-submission --workspace @remotejobos/worker",
    "worker:process-auto-submissions": "npm run process-auto-submissions --workspace @remotejobos/worker",
    "worker:sync-gmail": "npm run sync-gmail --workspace @remotejobos/worker",
    "worker:send-notifications": "npm run send-notifications --workspace @remotejobos/worker",
    "worker:enrich-targets": "npm run enrich-targets --workspace @remotejobos/worker"
  },
  "engines": {
    "node": ">=22"
  }
}
